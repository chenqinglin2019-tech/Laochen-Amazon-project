{
  "operation_mode": "supervised",
  "job_id": "amazon-image-competitors",
  "outputs_root": "outputs",
  "products_file": "inputs/image_competitors.example.csv",
  "marketplace": "美国站",
  "search_strategy": "sellersprite_stylesnap_url",
  "max_candidates_per_source": 48,
  "max_competitors_per_source": 48,
  "result_mode": "count_only",
  "min_match_confidence": 0.7,
  "include_source_as_competitor": false,
  "match_mode": "cascade",
  "doubao_embedding_config_file": "config/doubao_embedding_vision.json",
  "embedding_retry_attempts": 3,
  "embedding_retry_backoff_seconds": 1.0,
  "prescreen_min_similarity": 0.7,
  "prescreen_max_matches": 10,
  "doubao_mini_config_file": "config/doubao_same_product_mini.json",
  "mini_batch_size": 6,
  "mini_retry_attempts": 3,
  "mini_retry_backoff_seconds": 1,
  "vision_batch_size": 6,
  "vision_timeout": 120,
  "browser_backend": "opencli",
  "browser_mode": "reuse",
  "resume": true,
  "activate_plugin": false,
  "page_scroll_before_extract": true,
  "page_scroll_step_ratio": 0.85,
  "sellersprite_required": false,
  "sellersprite_on_lens": false,
  "enrich_accepted_results": false,
  "delivery_location_enabled": true,
  "delivery_locations_file": "config/amazon_delivery_locations.json",
  "delivery_location_timeout": 20,
  "save_debug_snapshots": true,
  "field_selectors": {
    "review_count": [],
    "rating_value": [],
    "seller_name": [],
    "brand_name": [],
    "seller_country": [],
    "sales_30_days_child": [],
    "sales_30_days_parent": [],
    "fba_fee": [],
    "gross_margin": [],
    "fulfillment_method": [],
    "delivery_duration": [],
    "launch_date": [],
    "organic_keywords_count": [],
    "ad_keywords_count": []
  },
  "mode": "image_competitor",
  "entry_mode": "batch"
}
