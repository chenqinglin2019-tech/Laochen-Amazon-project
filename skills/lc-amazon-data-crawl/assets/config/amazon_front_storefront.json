{
  "mode": "storefront",
  "job_id": "storefront-plugin-new-job",
  "browser_backend": "opencli",
  "entry_mode": "batch",
  "operation_mode": "supervised",
  "marketplace_domain": "amazon.com",
  "store_max_records": 1008,
  "outputs_root": "outputs",
  "resume": true,
  "include_sponsored": true,
  "browser_tab_concurrency": 1,
  "product_filters": {
    "allowed_fulfillment_methods": [],
    "excluded_fulfillment_methods": [],
    "allow_missing_fulfillment": false,
    "require_subcategory_rank": false
  },
  "store_urls_file": "inputs/storefronts.example.csv",
  "store_sort_orders": [
    "Newest Arrivals"
  ]
}
