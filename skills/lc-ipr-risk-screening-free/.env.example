# Copy to .env only when it does not already exist; supply approved credentials.
# Values are parsed as text: no shell execution, variable expansion, or environment injection.
# Syntax: NAME=value, optional matching single/double quotes; comments occupy their own # line.
# Duplicate keys and unmatched quotes are invalid; $ and # inside values remain literal.
# Empty values are unconfigured. Store the backend token in config.json, never here.
# On macOS/Unix, .env and config.json must both have mode 0600.
# Never commit or distribute the populated files. A configured key does not enable a source.
EPO_OPS_CONSUMER_KEY=
EPO_OPS_CONSUMER_SECRET=
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
JPO_API_USERNAME=
JPO_API_PASSWORD=
INPI_USERNAME=
INPI_PASSWORD=
SERPER_API_KEY=
SIGNA_API_KEY=
SERPAPI_API_KEY=
RAPIDAPI_KEY=
