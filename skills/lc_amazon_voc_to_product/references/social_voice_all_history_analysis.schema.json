{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex.skills/lc_amazon_market_opportunity/social_voice_all_history_analysis.schema.json",
  "title": "All-history consumer voice analysis with independent evidence readiness",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "project",
    "funnel",
    "sample_structure",
    "semantic_categories",
    "category_summary",
    "top_segments",
    "kano",
    "new_needs",
    "product_concepts",
    "validation",
    "limitations",
    "representative_voices"
  ],
  "properties": {
    "business_rules_version": {
      "type": "string"
    },
    "methodology": {
      "type": "object",
      "properties": {
        "prd_version": {
          "type": "string"
        },
        "thresholds": {
          "type": "object"
        }
      }
    },
    "schema_version": {
      "const": "3.0.0-all-history"
    },
    "metadata": {
      "type": "object",
      "required": [
        "mode",
        "no_network",
        "date_filter_applied",
        "source_db_sha256",
        "taxonomy_profile"
      ],
      "properties": {
        "mode": {
          "const": "all_history_local_reprocess"
        },
        "no_network": {
          "const": true
        },
        "date_filter_applied": {
          "const": false
        },
        "source_db_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "project": {
      "type": "object"
    },
    "funnel": {
      "$ref": "social_voice_all_history_coding.schema.json#/$defs/funnel"
    },
    "sample_structure": {
      "type": "object"
    },
    "semantic_categories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "purchase_selection_recommendation"
                },
                "label": {
                  "const": "购买、选型和推荐"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "failure_complaint_return_alternative"
                },
                "label": {
                  "const": "故障、抱怨、退货和替代"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "satisfaction_recommendation_repurchase"
                },
                "label": {
                  "const": "满意、推荐和复购"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "installation_compatibility_scenario"
                },
                "label": {
                  "const": "安装、兼容性和使用场景"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "diy_modification_workaround"
                },
                "label": {
                  "const": "DIY、改装和绕行方案"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/semanticMetric"
            },
            {
              "properties": {
                "code": {
                  "const": "feature_reverse_innovation"
                },
                "label": {
                  "const": "新功能、反向需求和创意"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "category_summary": {
      "type": "object"
    },
    "top_segments": {
      "type": "array",
      "maxItems": 3
    },
    "kano": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "need",
              "kano_type",
              "count",
              "share"
            ],
            "properties": {
              "kano_type": {
                "enum": [
                  "必备型",
                  "期望型",
                  "魅力型",
                  "无差异型",
                  "反向型"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "related_count": {
                "type": "integer",
                "minimum": 0
              },
              "classified_count": {
                "type": "integer",
                "minimum": 0
              },
              "related_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "dominant_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "type_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "rationale": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "need_id",
              "count",
              "status",
              "rationale",
              "evidence_ids"
            ],
            "properties": {
              "need_id": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "pending",
                  "classified",
                  "insufficient",
                  "conflict",
                  "not_applicable",
                  "below_threshold"
                ]
              },
              "classification": {
                "enum": [
                  "M",
                  "O",
                  "A",
                  "I",
                  "R",
                  null
                ]
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "denominator": {
                "type": "integer",
                "minimum": 0
              },
              "rationale": {
                "type": "string"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "new_needs": {
      "type": "array"
    },
    "product_concepts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "feature_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature",
                "origin",
                "voice_ids",
                "counterevidence_ids",
                "reasoning",
                "validation_plan"
              ],
              "properties": {
                "origin": {
                  "enum": [
                    "consumer_explicit",
                    "evidence_inference",
                    "design_hypothesis"
                  ]
                },
                "voice_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "counterevidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "bom_estimate": {
            "type": "object"
          }
        }
      }
    },
    "validation": {
      "type": "object"
    },
    "limitations": {
      "type": "array"
    },
    "representative_voices": {
      "type": "array"
    },
    "exploration_concepts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "development": {
      "type": "object"
    },
    "processing_status": {
      "enum": [
        "complete",
        "completed",
        "pending_review"
      ]
    },
    "coding_review": {
      "type": "object"
    },
    "collection_summary": {
      "type": "object"
    },
    "source_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_kind",
          "count",
          "share",
          "known_authors",
          "contexts"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "social",
              "review",
              "after_sales"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "share": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence_readiness": {
      "type": "object",
      "required": [
        "status",
        "checks",
        "gaps",
        "thresholds",
        "saturation",
        "needs"
      ],
      "properties": {
        "status": {
          "enum": [
            "sufficient",
            "partial"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "code",
              "label",
              "passed",
              "observed",
              "required"
            ],
            "properties": {
              "passed": {
                "type": "boolean"
              },
              "blocking": {
                "type": "boolean"
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thresholds": {
          "type": "object"
        },
        "saturation": {
          "type": "object",
          "required": [
            "status",
            "batches"
          ],
          "properties": {
            "status": {
              "enum": [
                "saturated",
                "not_saturated",
                "informational_only"
              ]
            },
            "batches": {
              "type": "array"
            }
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "label",
              "eligible",
              "known_authors",
              "contexts",
              "channels",
              "support_refs",
              "counter_refs",
              "segment_ids",
              "applicability",
              "alternative_explanations"
            ],
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "support_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "counter_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "kano_audit": {
      "type": [
        "array",
        "object"
      ]
    },
    "report_presentation": {
      "type": "object",
      "required": [
        "schema_version",
        "review_version",
        "product_directions"
      ],
      "properties": {
        "schema_version": {
          "const": "consumer-report-presentation-1.0"
        },
        "review_version": {
          "type": "string",
          "minLength": 1
        },
        "product_directions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "concept_id",
              "source_sha256",
              "status",
              "operations",
              "development",
              "decision",
              "benchmark",
              "mechanism_labels"
            ],
            "properties": {
              "concept_id": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              },
              "operations": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              },
              "development": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              },
              "decision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 220
              },
              "benchmark": {
                "type": "object",
                "required": [
                  "existing",
                  "proposal",
                  "value",
                  "tradeoff",
                  "test",
                  "stop",
                  "boundary"
                ],
                "properties": {
                  "existing": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "proposal": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "tradeoff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "test": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "stop": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  },
                  "boundary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 220
                  }
                },
                "additionalProperties": false
              },
              "mechanism_labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "benchmark_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "benchmark_title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "social_voice_all_history_coding.schema.json#/$defs/cleanNode"
    }
  ],
  "$defs": {
    "semanticMetric": {
      "type": "object",
      "required": [
        "code",
        "label",
        "count",
        "share",
        "authors",
        "threads",
        "platforms"
      ],
      "properties": {
        "code": {
          "$ref": "social_voice_all_history_coding.schema.json#/$defs/semanticCode"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "authors": {
          "type": "integer",
          "minimum": 0
        },
        "threads": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
