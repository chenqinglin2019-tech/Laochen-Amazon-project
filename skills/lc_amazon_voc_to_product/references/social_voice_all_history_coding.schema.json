{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex.skills/lc_amazon_market_opportunity/social_voice_all_history_coding.schema.json",
  "title": "All-history consumer voice coding with auditable Agent review",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "project",
    "semantic_taxonomy",
    "funnel",
    "voices",
    "excluded_records",
    "validation",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0-all-history"
    },
    "metadata": {
      "type": "object",
      "required": [
        "mode",
        "no_network",
        "date_filter_applied",
        "source_db_sha256",
        "taxonomy_profile"
      ],
      "properties": {
        "mode": {
          "const": "all_history_local_reprocess"
        },
        "no_network": {
          "const": true
        },
        "date_filter_applied": {
          "const": false
        },
        "source_db_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "taxonomy_profile": {
          "type": "object",
          "required": [
            "profile_id",
            "source",
            "product_label"
          ],
          "properties": {
            "profile_id": {
              "type": "string",
              "minLength": 3
            },
            "source": {
              "enum": [
                "built_in",
                "file"
              ]
            },
            "product_label": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "project": {
      "type": "object"
    },
    "semantic_taxonomy": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "$ref": "#/$defs/taxonomyPurchase"
        },
        {
          "$ref": "#/$defs/taxonomyFailure"
        },
        {
          "$ref": "#/$defs/taxonomySatisfaction"
        },
        {
          "$ref": "#/$defs/taxonomyInstallation"
        },
        {
          "$ref": "#/$defs/taxonomyDiy"
        },
        {
          "$ref": "#/$defs/taxonomyInnovation"
        }
      ],
      "items": false
    },
    "funnel": {
      "$ref": "#/$defs/funnel"
    },
    "voices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "voice_id",
          "hard_identity",
          "platform",
          "excerpt",
          "semantic_codes",
          "product_context_source",
          "inclusion_reason"
        ],
        "properties": {
          "voice_id": {
            "type": "string",
            "minLength": 1
          },
          "hard_identity": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "semantic_codes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/semanticCode"
            }
          },
          "product_context_source": {
            "type": "string",
            "minLength": 1
          },
          "inclusion_reason": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "enum": [
              "social",
              "review",
              "after_sales"
            ]
          },
          "coding_method": {
            "enum": [
              "agent_reviewed",
              "rule_provisional",
              "rule_classified",
              "model_reviewed"
            ]
          },
          "coding_status": {
            "enum": [
              "classified",
              "reviewed",
              "requires_agent_review"
            ]
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cache_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "author_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "thread_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "needs": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/codedNeed"
            }
          }
        }
      }
    },
    "excluded_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "hard_identity",
          "platform",
          "reason"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "hard_identity": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pending_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "hard_identity",
          "reason",
          "excerpt",
          "cache_key"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "hard_identity": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "processing_status": {
      "enum": [
        "complete",
        "completed",
        "pending_review"
      ]
    },
    "coding_review": {
      "type": "object",
      "required": [
        "agent_reviewed",
        "rule_provisional",
        "pending",
        "unreviewed_records",
        "coverage",
        "queue_path"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/cleanNode"
    }
  ],
  "$defs": {
    "semanticCode": {
      "enum": [
        "purchase_selection_recommendation",
        "failure_complaint_return_alternative",
        "satisfaction_recommendation_repurchase",
        "installation_compatibility_scenario",
        "diy_modification_workaround",
        "feature_reverse_innovation"
      ]
    },
    "taxonomyPurchase": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "purchase_selection_recommendation"
        },
        "label": {
          "const": "购买、选型和推荐"
        }
      },
      "additionalProperties": false
    },
    "taxonomyFailure": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "failure_complaint_return_alternative"
        },
        "label": {
          "const": "故障、抱怨、退货和替代"
        }
      },
      "additionalProperties": false
    },
    "taxonomySatisfaction": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "satisfaction_recommendation_repurchase"
        },
        "label": {
          "const": "满意、推荐和复购"
        }
      },
      "additionalProperties": false
    },
    "taxonomyInstallation": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "installation_compatibility_scenario"
        },
        "label": {
          "const": "安装、兼容性和使用场景"
        }
      },
      "additionalProperties": false
    },
    "taxonomyDiy": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "diy_modification_workaround"
        },
        "label": {
          "const": "DIY、改装和绕行方案"
        }
      },
      "additionalProperties": false
    },
    "taxonomyInnovation": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "const": "feature_reverse_innovation"
        },
        "label": {
          "const": "新功能、反向需求和创意"
        }
      },
      "additionalProperties": false
    },
    "funnel": {
      "type": "object",
      "required": [
        "discovered_records",
        "hard_unique_records",
        "examined_records",
        "qualified_consumer_voices",
        "excluded_records",
        "platforms",
        "exclusion_reasons"
      ],
      "properties": {
        "discovered_records": {
          "type": "integer",
          "minimum": 0
        },
        "hard_unique_records": {
          "type": "integer",
          "minimum": 0
        },
        "examined_records": {
          "type": "integer",
          "minimum": 0
        },
        "qualified_consumer_voices": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_records": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "array"
        },
        "exclusion_reasons": {
          "type": "array"
        },
        "pending_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cleanNode": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "(confidence|window|(^|_)(start_at|end_at|time_range|date_range)($|_)|source[_ -]?status|(^|_)evidence(_[a-z]+)*_(counts?|totals?)($|_)|(^|_)(counts?|totals?)(_[a-z]+)*_evidence($|_)|(category|segment)(_[a-z0-9]+)*_(30d|90d))"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/cleanNode"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cleanNode"
          }
        },
        {
          "type": "string",
          "not": {
            "pattern": "((category|segment)(_[a-z0-9]+)*_(30d|90d))"
          }
        },
        {
          "type": [
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "codedNeed": {
      "type": "object",
      "required": [
        "code",
        "label",
        "quote",
        "stance",
        "applicability",
        "applicability_reason",
        "alternative_explanations",
        "serious",
        "novel"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "stance": {
          "enum": [
            "support",
            "counter",
            "mixed",
            "context"
          ]
        },
        "applicability": {
          "enum": [
            "current",
            "historical",
            "unknown"
          ]
        },
        "applicability_reason": {
          "type": "string"
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serious": {
          "type": "boolean"
        },
        "novel": {
          "type": "boolean"
        },
        "kano_type": {
          "enum": [
            "必备型",
            "期望型",
            "魅力型",
            "无差异型",
            "反向型"
          ]
        },
        "kano_reason": {
          "type": "string",
          "minLength": 1
        },
        "kano_review_status": {
          "enum": [
            "unreviewed",
            "classified",
            "insufficient",
            "conflict"
          ]
        },
        "kano_review_version": {
          "type": "string",
          "minLength": 1
        },
        "need_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "kano_review_status"
            ]
          },
          "then": {
            "required": [
              "kano_review_version"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kano_review_status"
            ],
            "properties": {
              "kano_review_status": {
                "const": "classified"
              }
            }
          },
          "then": {
            "required": [
              "kano_type",
              "kano_reason"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kano_review_status"
            ],
            "properties": {
              "kano_review_status": {
                "enum": [
                  "unreviewed",
                  "insufficient",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "kano_type"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "kano_review_version"
            ]
          },
          "then": {
            "required": [
              "kano_review_status"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kano_review_status"
            ],
            "properties": {
              "kano_review_status": {
                "enum": [
                  "classified",
                  "insufficient",
                  "conflict"
                ]
              }
            }
          },
          "then": {
            "required": [
              "kano_reason"
            ]
          }
        }
      ]
    },
    "agentDecision": {
      "type": "object",
      "required": [
        "cache_key",
        "hard_identity",
        "text_sha256",
        "context_sha256",
        "taxonomy_sha256",
        "reviewed_by",
        "reason",
        "decision"
      ],
      "properties": {
        "cache_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decision": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "semantic_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticCode"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codedNeed"
          },
          "minItems": 1
        },
        "segment_memberships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "product_context": {
          "type": "object",
          "required": [
            "basis",
            "quote"
          ],
          "properties": {
            "basis": {
              "enum": [
                "self",
                "saved_context"
              ]
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "record_id": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "include"
              }
            }
          },
          "then": {
            "required": [
              "semantic_codes",
              "needs",
              "segment_memberships",
              "product_context"
            ]
          }
        }
      ]
    }
  }
}
