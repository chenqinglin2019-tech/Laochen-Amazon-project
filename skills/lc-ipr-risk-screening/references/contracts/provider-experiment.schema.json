{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:provider-experiment:0.1",
  "title": "Sanitized Provider Capability Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "provider", "capability", "transport",
    "promotion_state", "conducted_at", "credential_owner", "jurisdictions",
    "right_types", "scenarios", "artifacts", "cost", "privacy", "limits", "decision"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_-]{4,100}$"},
    "compared_with": {"type": "string", "pattern": "^EXP-[A-Za-z0-9_-]{4,100}$"},
    "provider": {"type": "string", "minLength": 1, "maxLength": 80},
    "capability": {"type": "string", "minLength": 1, "maxLength": 120},
    "transport": {"enum": ["cli", "product_gateway", "user_byok_https", "public_api", "public_browser", "agent_browser", "local_mock"]},
    "promotion_state": {"enum": ["unresearched", "experiment_ready", "tested", "limited", "accepted", "rejected", "blocked", "pipeline"]},
    "conducted_at": {"type": "string", "format": "date-time"},
    "credential_owner": {"enum": ["product_cloud", "user_byok", "public_none", "not_applicable"]},
    "jurisdictions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"}},
    "right_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome", "notes"],
        "properties": {
          "name": {"enum": ["success", "no_result", "partial", "malformed", "timeout", "auth", "quota", "rate_limit", "retry"]},
          "outcome": {"enum": ["passed", "failed", "not_tested", "not_applicable", "blocked", "limited"]},
          "artifact": {"type": ["string", "null"]},
          "notes": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "scenario", "path", "sha256", "media_type", "sanitized"],
        "properties": {
          "kind": {"enum": ["request", "response", "error", "screenshot", "trace", "other"]},
          "scenario": {"enum": ["success", "no_result", "partial", "malformed", "timeout", "auth", "quota", "rate_limit", "retry"]},
          "path": {"type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
          "sanitized": {"const": true}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {"enum": ["charged", "not_charged", "not_observable", "not_applicable"]},
        "units": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "unit_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 40},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sends_product_text", "sends_images", "retention_status", "notes"],
      "properties": {
        "sends_product_text": {"type": "boolean"},
        "sends_images": {"type": "boolean"},
        "retention_status": {"enum": ["documented", "tested", "unknown", "not_applicable"]},
        "notes": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_known", "rate_limit_known", "quota_known", "retry_policy_known", "notes"],
      "properties": {
        "timeout_known": {"type": "boolean"},
        "rate_limit_known": {"type": "boolean"},
        "quota_known": {"type": "boolean"},
        "retry_policy_known": {"type": "boolean"},
        "notes": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conclusion", "pipeline_eligible", "rationale", "limitations"],
      "properties": {
        "conclusion": {"enum": ["accepted", "limited", "rejected", "blocked", "more_evidence_needed"]},
        "pipeline_eligible": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 3000},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    }
  }
}
