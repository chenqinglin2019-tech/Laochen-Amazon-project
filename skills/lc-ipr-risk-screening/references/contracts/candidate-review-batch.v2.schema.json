{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:candidate-review-batch:2.0",
  "title": "Candidate Review Batch v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_version", "task_id", "evidence_digest", "decided_by", "decisions"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "ruleset_version": {"const": "2.0"},
    "task_id": {"type": "string", "pattern": "^(?:ipr|fixture)_[A-Za-z0-9_-]{8,100}$"},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decided_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "session_id"],
      "properties": {
        "type": {"enum": ["agent", "human"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "rationale"],
        "properties": {
          "candidate": {"$ref": "urn:lc-ipr-risk-screening:candidate:2.0"},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 10000}
        }
      }
    }
  }
}
