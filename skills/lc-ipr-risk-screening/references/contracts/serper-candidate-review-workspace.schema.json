{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:serper-candidate-review-workspace:0.1",
  "title": "Serper Candidate Review Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "evidence_digest", "candidate_count", "items", "updated_at"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 0},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "module", "jurisdiction", "right_type", "source_locator", "summary", "evidence_refs", "disposition"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]{4,100}$"},
        "module": {"enum": ["appearance_design", "utility_patent", "pending_patent", "word_mark", "figurative_trade_dress", "copyright_creative_ip", "enforcement_public_signals"]},
        "jurisdiction": {"const": "US"},
        "right_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "record_number": {"type": "string", "minLength": 1, "maxLength": 200},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "owner": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_locator": {"type": "string", "minLength": 1, "maxLength": 5000},
        "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]{4,100}$"}},
        "disposition": {"const": "unreviewed"}
      }
    }
  }
}
