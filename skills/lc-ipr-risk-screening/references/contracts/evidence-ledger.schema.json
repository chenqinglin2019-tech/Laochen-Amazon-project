{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:evidence-ledger:0.1",
  "title": "Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "revision", "parent_digest", "query_plan_digest", "provider_runs", "evidence_items", "candidates", "official_verifications", "copyright_provenance_verifications", "updated_at", "digest", "frozen", "frozen_at"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "revision": {"type": "integer", "minimum": 1},
    "parent_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "query_plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "query_id", "result_path", "result_sha256"],
        "properties": {
          "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_-]{4,100}$"},
          "query_id": {"type": "string", "pattern": "^Q-[A-Za-z0-9_-]{4,80}$"},
          "result_path": {"type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+"},
          "result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "run_id", "source_index", "module", "jurisdiction", "right_type", "record_number", "title", "owner", "source_locator", "summary", "raw_refs"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]{4,100}$"},
          "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_-]{4,100}$"},
          "source_index": {"type": "integer", "minimum": 0},
          "module": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
          "right_type": {"type": "string", "minLength": 1, "maxLength": 80},
          "record_number": {"type": ["string", "null"], "maxLength": 200},
          "title": {"type": ["string", "null"], "maxLength": 500},
          "owner": {"type": ["string", "null"], "maxLength": 500},
          "source_locator": {"type": "string", "minLength": 1, "maxLength": 2000},
          "summary": {"type": "string", "minLength": 1, "maxLength": 5000},
          "raw_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:raw|screenshots)/.+"}}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "candidate_key", "evidence_refs", "source_refs", "module", "jurisdiction", "right_type", "record_number", "title", "owner", "disposition"],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]{4,100}$"},
          "candidate_key": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[A-Za-z0-9_-]{4,100}$"}},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["run_id", "source_index"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_-]{4,100}$"},
                "source_index": {"type": "integer", "minimum": 0}
              }
            }
          },
          "module": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
          "right_type": {"type": "string", "minLength": 1, "maxLength": 80},
          "record_number": {"type": ["string", "null"], "maxLength": 200},
          "title": {"type": ["string", "null"], "maxLength": 500},
          "owner": {"type": ["string", "null"], "maxLength": 500},
          "disposition": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "deterministic_triggers", "exclusion_codes", "rationale", "decided_by", "decided_at", "evidence_revision", "review_basis_digest"],
                "properties": {
                  "value": {"enum": ["material", "not_material", "needs_review"]},
                  "deterministic_triggers": {"type": "array", "uniqueItems": true, "items": {"enum": ["exact_record_match", "title_or_identifier_match", "technical_claim_overlap", "related_family_or_continuation", "visual_similarity", "word_mark_similarity", "figurative_mark_similarity", "goods_services_overlap", "enforcement_subject_match", "provenance_or_ownership_conflict", "status_or_owner_uncertainty"]}},
                  "exclusion_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["different_jurisdiction", "different_right_type", "different_product_category", "different_technical_scope", "different_visual_impression", "different_mark", "different_goods_services", "duplicate_record", "non_product_specific_signal", "invalid_or_non_right_record"]}},
                  "rationale": {"type": "string", "minLength": 1, "maxLength": 5000},
                  "decided_by": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "id", "session_id"],
                    "properties": {
                      "type": {"enum": ["agent", "human", "backend", "reviewer"]},
                      "id": {"type": "string", "minLength": 1, "maxLength": 128},
                      "session_id": {"type": "string", "minLength": 1, "maxLength": 128}
                    }
                  },
                  "decided_at": {"type": "string", "format": "date-time"},
                  "evidence_revision": {"type": "integer", "minimum": 1},
                  "review_basis_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                }
              }
            ]
          }
        }
      }
    },
    "official_verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_id", "candidate_id", "event_path", "event_sha256"],
        "properties": {
          "verification_id": {"type": "string", "pattern": "^V-[A-Za-z0-9_-]{4,100}$"},
          "candidate_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]{4,100}$"},
          "event_path": {"type": "string", "pattern": "^normalized/official-verifications/.+\\.json$"},
          "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "copyright_provenance_verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verification_id", "candidate_id", "event_path", "event_sha256"],
        "properties": {
          "verification_id": {"type": "string", "pattern": "^CPV-[a-f0-9]{24}$"},
          "candidate_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]{4,100}$"},
          "event_path": {"type": "string", "pattern": "^normalized/copyright-provenance-verifications/.+\\.json$"},
          "event_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frozen": {"type": "boolean"},
    "frozen_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
