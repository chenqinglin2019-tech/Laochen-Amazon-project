{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:coverage-report:0.1",
  "title": "Query Coverage Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "query_plan_digest",
    "evidence_digest",
    "status",
    "assessment_ready",
    "required_total",
    "completed_total",
    "rows",
    "gap_query_ids",
    "evaluated_at",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "query_plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["complete", "incomplete"]},
    "assessment_ready": {"type": "boolean"},
    "required_total": {"type": "integer", "minimum": 1},
    "completed_total": {"type": "integer", "minimum": 0},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "module",
          "target_jurisdiction",
          "provider_jurisdiction",
          "required",
          "coverage_status",
          "reason_code",
          "matching_run_ids"
        ],
        "properties": {
          "query_id": {"type": "string", "pattern": "^Q-[A-Za-z0-9_-]{4,80}$"},
          "module": {
            "enum": [
              "appearance_design",
              "utility_patent",
              "pending_patent",
              "word_mark",
              "figurative_trade_dress",
              "copyright_creative_ip",
              "enforcement_public_signals"
            ]
          },
          "target_jurisdiction": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
          "provider_jurisdiction": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$"},
          "required": {"type": "boolean"},
          "coverage_status": {"enum": ["complete", "missing", "needs_user_action", "access_limited", "failed", "invalid"]},
          "reason_code": {"type": "string", "minLength": 1, "maxLength": 160},
          "matching_run_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^RUN-[A-Za-z0-9_-]{4,100}$"}
          }
        }
      }
    },
    "gap_query_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^Q-[A-Za-z0-9_-]{4,80}$"}
    },
    "evaluated_at": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
