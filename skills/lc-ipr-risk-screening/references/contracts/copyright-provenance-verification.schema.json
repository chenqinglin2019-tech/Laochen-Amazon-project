{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:copyright-provenance-verification:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "task_id", "candidate_id", "candidate_key", "evidence_revision", "asset_ref", "asset_sha256", "resolution", "creator", "rights_owner", "rights_basis", "license_scope", "territory", "term", "commercial_use_allowed", "amazon_use_allowed", "proof_refs", "verified_by", "verified_at", "notes", "digest"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "verification_id": {"type": "string", "pattern": "^CPV-[a-f0-9]{24}$"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "candidate_id": {"type": "string", "pattern": "^C-[A-Za-z0-9_-]{4,100}$"},
    "candidate_key": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_revision": {"type": "integer", "minimum": 1},
    "asset_ref": {"type": "string", "minLength": 1, "maxLength": 4096},
    "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resolution": {"enum": ["owned", "licensed", "unlicensed", "unknown"]},
    "creator": {"type": "string", "maxLength": 500},
    "rights_owner": {"type": "string", "maxLength": 500},
    "rights_basis": {"enum": ["original", "license", "assignment", "employment", "commissioned", "public_domain", "unknown"]},
    "license_scope": {"type": "string", "maxLength": 2000},
    "territory": {"type": "string", "maxLength": 500},
    "term": {"type": "string", "maxLength": 500},
    "commercial_use_allowed": {"type": "boolean"},
    "amazon_use_allowed": {"type": "boolean"},
    "proof_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"enum": ["creation_record", "assignment", "license", "employment_record", "commission_agreement", "public_domain_record", "conflict_evidence"]}, "path": {"type": "string", "pattern": "^raw/copyright-provenance/.+"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "verified_by": {"$ref": "#/$defs/actor"},
    "verified_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string", "maxLength": 5000},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"actor": {"type": "object", "additionalProperties": false, "required": ["type", "id", "session_id"], "properties": {"type": {"enum": ["agent", "human", "backend", "reviewer"]}, "id": {"type": "string", "minLength": 1, "maxLength": 128}, "session_id": {"type": "string", "minLength": 1, "maxLength": 128}}}}
}
