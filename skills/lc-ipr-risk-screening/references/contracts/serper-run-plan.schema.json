{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:serper-run-plan:0.1",
  "title": "Serper Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "control_version", "plan_id", "task_id", "query_plan_digest", "items", "disclosure", "created_at", "digest"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "control_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^SERPLAN-[a-f0-9]{24}$"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "query_plan_digest": {"$ref": "#/$defs/digest"},
    "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/item"}},
    "disclosure": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "created_at": {"type": "string", "format": "date-time"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["query_id", "module", "jurisdiction", "right_type", "provider", "endpoint", "request_path", "request_sha256"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^Q-[A-Za-z0-9_-]{4,80}$"},
        "module": {"enum": ["appearance_design", "utility_patent", "pending_patent", "word_mark", "figurative_trade_dress", "copyright_creative_ip", "enforcement_public_signals"]},
        "jurisdiction": {"const": "US"},
        "right_type": {"type": "string", "minLength": 1, "maxLength": 80},
        "provider": {"type": "string", "minLength": 1, "maxLength": 100},
        "endpoint": {"enum": ["search", "patents", "images", "lens"]},
        "request_path": {"type": "string", "pattern": "^serper/requests/[^/]+\\.json$"},
        "request_sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
