{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:product-corroboration:0.1",
  "title": "ASIN Product Corroboration Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "product_facts_digest",
    "reviewer",
    "reviewed_at",
    "checks",
    "decision",
    "rationale",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "task_id": {"type": "string", "pattern": "^ipr_[A-Za-z0-9_-]{8,80}$"},
    "product_facts_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["agent", "user", "reviewer"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "reviewed_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome", "evidence_refs", "rationale"],
        "properties": {
          "name": {"enum": ["identifier_binding", "text_internal_consistency", "main_image_consistency"]},
          "outcome": {"enum": ["corroborated", "conflict", "unknown"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "decision": {"enum": ["accepted", "needs_user_action", "rejected"]},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 3000},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
