{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lc-ipr-risk-screening:risk-evaluation-input:2.0",
  "title": "Risk Evaluation Input v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_version", "task_id", "assessment_status", "coverage", "candidates", "modules", "review"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "ruleset_version": {"const": "2.0"},
    "task_id": {"type": "string", "pattern": "^(?:ipr|fixture)_[A-Za-z0-9_-]{8,100}$"},
    "assessment_status": {"enum": ["final", "draft"]},
    "coverage": {"$ref": "#/$defs/coverage"},
    "candidates": {"type": "array", "maxItems": 10000, "items": {"$ref": "urn:lc-ipr-risk-screening:candidate:2.0"}},
    "modules": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/module_input"},
      "allOf": [
        {"contains": {"properties": {"module": {"const": "appearance_design"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "utility_patent"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "pending_patent"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "word_mark"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "figurative_mark"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "trade_dress"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "copyright_creative_ip"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"properties": {"module": {"const": "enforcement_public_signals"}}, "required": ["module"]}, "minContains": 1, "maxContains": 1}
      ]
    },
    "review": {"$ref": "#/$defs/review"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "module": {
      "enum": ["appearance_design", "utility_patent", "pending_patent", "word_mark", "figurative_mark", "trade_dress", "copyright_creative_ip", "enforcement_public_signals"]
    },
    "confidence": {"enum": ["low", "medium", "high"]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence", "complete", "gaps"],
      "properties": {
        "confidence": {"$ref": "#/$defs/confidence"},
        "complete": {"type": "boolean"},
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "module", "detail", "blocking"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,100}$"},
              "module": {"$ref": "#/$defs/module"},
              "detail": {"type": "string", "pattern": "\\S", "maxLength": 2000},
              "blocking": {"type": "boolean"}
            }
          }
        }
      }
    },
    "module_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "assessability", "confidence", "candidate_ids", "reasoning"],
      "properties": {
        "module": {"$ref": "#/$defs/module"},
        "assessability": {"enum": ["assessable", "partially_assessable", "not_assessable"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{3,127}$"}
        },
        "provenance_complete": {"type": "boolean"},
        "unresolved_material_facts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S", "maxLength": 2000}},
        "reasoning": {"type": "string", "pattern": "\\S", "maxLength": 10000},
        "recommended_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "\\S", "maxLength": 2000}}
      }
    },
    "json_value": {
      "oneOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {"type": "array"},
        {"type": "object"}
      ]
    },
    "fact_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "module", "candidate_id", "fact_path", "first_review_value", "second_review_value", "rating_material", "status"],
      "properties": {
        "conflict_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "module": {"$ref": "#/$defs/module"},
        "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{3,127}$"},
        "fact_path": {"type": "string", "minLength": 1, "maxLength": 500},
        "first_review_value": {"$ref": "#/$defs/json_value"},
        "second_review_value": {"$ref": "#/$defs/json_value"},
        "rating_material": {"type": "boolean"},
        "status": {"enum": ["unresolved", "resolved_by_evidence", "resolved_by_human", "resolved_by_lawyer"]},
        "resolution_value": {"$ref": "#/$defs/json_value"},
        "resolution_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["resolved_by_evidence", "resolved_by_human", "resolved_by_lawyer"]}}, "required": ["status"]},
          "then": {
            "required": ["resolution_value", "resolution_evidence_refs"],
            "properties": {"resolution_evidence_refs": {"minItems": 1}}
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_conflicts"],
      "properties": {
        "fact_conflicts": {"type": "array", "items": {"$ref": "#/$defs/fact_conflict"}},
        "review_refs": {"$ref": "#/$defs/review_refs"},
        "resolution_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resolution_ref"}]}
      }
    },
    "review_refs": {
      "type": "array",
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/review_ref"}, {"properties": {"round": {"const": "first"}}}]},
        {"allOf": [{"$ref": "#/$defs/review_ref"}, {"properties": {"round": {"const": "second"}}}]}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "review_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_id", "round", "path", "digest", "context_digest", "evidence_digest", "reviewer_id", "session_id"],
      "properties": {
        "review_id": {"type": "string", "pattern": "^REV-[a-f0-9]{24}$"},
        "round": {"enum": ["first", "second"]},
        "path": {"type": "string", "pattern": "^normalized/reviews/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
        "digest": {"$ref": "#/$defs/digest"},
        "context_digest": {"$ref": "#/$defs/digest"},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "session_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "resolution_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_id", "path", "digest"],
      "properties": {
        "resolution_id": {"type": "string", "pattern": "^RES-[a-f0-9]{24}$"},
        "path": {"type": "string", "pattern": "^normalized/resolutions/[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
